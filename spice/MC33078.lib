********************************************************
** Standard Linear Ics Macromodels, 1993.
*
** MC33078 Dual Low-Noise Operational Amplifier
** CONNECTIONS :
* 1 INVERTING INPUT
* 2 NON-INVERTING INPUT
* 3 OUTPUT
* 4 POSITIVE POWER SUPPLY
* 5 NEGATIVE POWER SUPPLY
********************************************************
.SUBCKT MC33078_AMP 1 3 2 4 5

.PARAM
+ RE   = 1.75E+05

.MODEL MDTH D 
+   IS=1E-8 
+   KF=2.286238E-16 
+   CJO=10F

* INPUT STAGE
CIP 2 5 1.200000E-11
